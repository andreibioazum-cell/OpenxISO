# ==========================================================================
# OpenxISO guest kernel: small, fast-booting, 64-bit, serial + VGA console.
# Used as the base config for tools/linux-guest (see README in that dir).
# Everything not listed here keeps its Kconfig default.
# ==========================================================================

# --- 64-bit, uniprocessor ---
CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_SMP=n
CONFIG_NR_CPUS=1
CONFIG_X86_MCE=n
CONFIG_MICROCODE=n
CONFIG_X86_5LEVEL=n
CONFIG_NUMA=n

# --- deterministic, non-relocatable image ---
CONFIG_RELOCATABLE=n
CONFIG_RANDOMIZE_BASE=n
CONFIG_PHYSICAL_START=0x1000000
CONFIG_PHYSICAL_ALIGN=0x200000
CONFIG_PAGE_TABLE_ISOLATION=n

# --- timers / preemption ---
CONFIG_HZ_100=y
CONFIG_HZ=100
CONFIG_NO_HZ_IDLE=n
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_NONE=y
CONFIG_PREEMPT_VOLUNTARY=n
CONFIG_PREEMPT_DYNAMIC=n
CONFIG_HZ_PERIODIC=y

# --- no speculative-execution mitigations (this is an emulator) ---
CONFIG_RETPOLINE=n
CONFIG_RETHUNK=n
CONFIG_SLS=n
CONFIG_X86_KERNEL_IBT=n
CONFIG_CALL_DEPTH_TRACKING=n
CONFIG_CPU_IBPB_ENTRY=n
CONFIG_CPU_IBRS_ENTRY=n
CONFIG_CPU_SRSO=n
CONFIG_CALL_PADDING=n
CONFIG_DEBUG_ENTRY=n
CONFIG_UNWINDER_FRAME_POINTER=y
CONFIG_UNWINDER_ORC=n
CONFIG_STACK_VALIDATION=n
CONFIG_NOINSTR_VALIDATION=n
CONFIG_HAVE_STATIC_CALL_INLINE=n

# --- no ACPI: classic PIC + PIT (the emulator implements both) ---
# X86_MPPARSE keeps its forced "y": without ACPI it has no prompt, so the
# value below is ignored.  Harmless: SeaBIOS' MP table only describes the
# IOAPIC the emulator really does implement (src/rust/cpu/ioapic.rs).
CONFIG_ACPI=n
CONFIG_X86_MPPARSE=n
CONFIG_APM=n
CONFIG_EFI=n
CONFIG_EFI_STUB=n
CONFIG_PM=n
CONFIG_SUSPEND=n
CONFIG_HIBERNATION=n
CONFIG_CPU_FREQ=n
CONFIG_CPU_IDLE=n
CONFIG_THERMAL=n
CONFIG_HYPERVISOR_GUEST=n
CONFIG_KVM_GUEST=n
CONFIG_XEN=n
CONFIG_PARAVIRT=n
# JUMP_LABEL has "select OBJTOOL if HAVE_JUMP_LABEL_HACK" on x86, and objtool
# cannot be built here (no libelf), so it must stay off.
CONFIG_JUMP_LABEL=n

# --- built-in command line (no bootloader needed) ---
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="console=tty0 console=ttyS0,115200 earlyprintk=serial"
CONFIG_CMDLINE_OVERRIDE=n

# --- console: serial first, then VGA text mode ---
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_DUMMY_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=n
CONFIG_SERIAL_8250_NR_UARTS=2
CONFIG_SERIAL_8250_RUNTIME_UARTS=2
CONFIG_SERIAL_8250_EXTENDED=n
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_EARLY_PRINTK=y
CONFIG_PRINTK=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_SERIAL=y
# --- console input: PS/2 keyboard drives the VGA console ---
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
# The PC speaker: the emulator plays what the guest's driver programs into the
# 8253/8255, so a real beep comes out of the browser's audio device.  The guest
# side is tools/linux-guest/beep.c, which drives it through evdev.
CONFIG_PCSPKR_PLATFORM=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_PCSPKR=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_INPUT_MOUSE=n
# evdev is how beep reaches the PC speaker driver
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SUPPORT=n
CONFIG_HW_RANDOM=n

# --- the emulated machine has a PIIX3 ISA bridge and the IDE task files at the
# --- legacy ports, so PCI plus libata are what turn an attached .hdd or ISO
# --- image into /dev/sda and /dev/sr0 ---
CONFIG_PCI=y
CONFIG_ATA=y
# The engine presents the IDE controller exactly like a PIIX3 does: as the PCI
# function 8086:7010 (class 01/01, "ISA compatibility mode-only controller,
# supports bus mastering") whose BAR0-BAR3 are the legacy ports 0x1F0/0x3F6 and
# 0x170/0x376 and whose BAR4 is the bus master register block at 0xB400.  The
# driver for that device is ata_piix, and it needs the BMDMA support it is
# built on.  It is only there when a drive is attached, so a machine with no
# disks has no IDE function at all.
CONFIG_ATA_PIIX=y
CONFIG_ATA_BMDMA=y
# pata_legacy would claim the legacy ports of a machine *without* the PCI
# function - there is no such machine here, and probing empty ports only costs
# boot time, so it stays off.
CONFIG_PATA_LEGACY=n
CONFIG_SCSI=y
# libata drives: disks as /dev/sda, CD-ROMs as /dev/sr0
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_NET=n
CONFIG_SOUND=n
CONFIG_USB_SUPPORT=n
# there is no separate IDE cdrom driver any more (BLK_DEV_IDECD went away with
# the old IDE stack in 5.14); libata plus BLK_DEV_SR is what handles CD images
# on both the legacy and the PCI ports
CONFIG_BLK_DEV_RAM=n
CONFIG_MD=n
CONFIG_DM=n
CONFIG_FUSION=n
CONFIG_BLK_DEV_LOOP=n
CONFIG_MMC=n
CONFIG_MTD=n
CONFIG_IIO=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_AGP=n
CONFIG_VIRTIO=n

# --- filesystems: just enough for an initramfs + devtmpfs + proc/sysfs ---
CONFIG_BLOCK=y
CONFIG_BLK_DEV_INITRD=y
# CONFIG_INITRAMFS_SOURCE is *not* set here: it has to point at the assembled
# initramfs (the busybox install plus this directory's skeleton) and at
# initramfs.devices, whose paths only exist while build.py runs, so build.py
# appends the resulting two-source value to the .config it writes.  With an
# empty value the kernel would embed its two-entry default_cpio_list instead.
CONFIG_INITRAMFS_COMPRESSION_GZIP=y
CONFIG_INITRAMFS_COMPRESSION_NONE=n
CONFIG_RD_GZIP=y
CONFIG_RD_BZIP2=n
CONFIG_RD_LZMA=n
CONFIG_RD_XZ=n
CONFIG_RD_LZO=n
CONFIG_RD_LZ4=n
CONFIG_RD_ZSTD=n
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=n
CONFIG_SHMEM=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_SYSCTL=y
CONFIG_CONFIGFS_FS=n
# ext2 is what busybox' mkfs.ext2 writes and mount reads; vfat and iso9660 are
# there for disk and CD images that come from a phone or a PC
CONFIG_EXT2_FS=y
# ext4 is the most likely filesystem on a disk image that came from a phone or
# a PC, and it is what makes "attach a .hdd and boot" work without the user
# having to format anything: ext4 pulls in jbd2 (the journal) and the CRC32C
# crypto helper on its own
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_ISO9660_FS=y
CONFIG_FUSE_FS=n
CONFIG_OVERLAY_FS=n
CONFIG_SQUASHFS=n
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_KEYS=n
CONFIG_QUOTA=n
CONFIG_XFS_FS=n
CONFIG_BTRFS_FS=n
CONFIG_PSTORE=n
CONFIG_DEBUG_FS=n
CONFIG_TRACEFS=n

# --- binary formats ---
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=n
CONFIG_COREDUMP=y
CONFIG_IA32_EMULATION=n
CONFIG_X86_X32_ABI=n
CONFIG_COMPAT_32=n

# --- size / speed ---
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=n
CONFIG_MODULES=n
# EXPERT is what makes the "un-optimise" knobs above visible/settable; it
# also selects DEBUG_KERNEL, which is why the latter ends up "y".
CONFIG_EXPERT=y
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=n
CONFIG_KPROBES=n
CONFIG_FUNCTION_TRACER=n
CONFIG_FTRACE=n
CONFIG_TRACING=n
CONFIG_BPF=n
CONFIG_BPF_SYSCALL=n
CONFIG_SECURITY=n
CONFIG_SECURITY_SELINUX=n
CONFIG_AUDIT=n
CONFIG_KEXEC=n
CONFIG_CRASH_DUMP=n
CONFIG_RELOCATABLE_DEBUG=n
CONFIG_PROFILING=n
CONFIG_OPROFILE=n
CONFIG_UPROBES=n
CONFIG_PERF_EVENTS=n
CONFIG_KCOV=n
CONFIG_KASAN=n
CONFIG_KCSAN=n
CONFIG_UBSAN=n
CONFIG_LOCKDEP=n
CONFIG_PROVE_LOCKING=n
CONFIG_REFCOUNT_FULL=n
CONFIG_SLUB_DEBUG=n
CONFIG_SLAB_MERGE_DEFAULT=y
CONFIG_FORTIFY_SOURCE=n
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_HARDENED_USERCOPY=n
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=n
CONFIG_INIT_ON_FREE_DEFAULT_ON=n
CONFIG_CC_HAS_ZERO_CALL_USED_REGS=n
CONFIG_ZERO_CALL_USED_REGS=n
CONFIG_PANIC_ON_OOPS=n
CONFIG_PANIC_TIMEOUT=0
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_BASE_FULL=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_AIO=y
CONFIG_IO_URING=n
CONFIG_POSIX_TIMERS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_CACHESTAT_SYSCALL=y
CONFIG_KALLSYMS_BASE_RELATIVE=y

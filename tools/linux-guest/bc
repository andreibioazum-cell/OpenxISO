#!/usr/bin/env python3
"""Tiny stand-in for GNU bc, good enough for kernel/time/timeconst.bc.

The kernel build uses bc in exactly one place:

    filechk_gentimeconst = echo $(CONFIG_HZ) | bc -q $<

where $< is kernel/time/timeconst.bc.  This script is invoked as

    bc -q kernel/time/timeconst.bc   with HZ on stdin

and reimplements the (tiny) bc program's arithmetic in Python, printing the
same header the real bc would produce.  Anything else is rejected loudly so
that a silently wrong result is impossible.
"""

import sys


def gcd(a, b):
    while b:
        a, b = b, a % b
    return a


def fmul(b, n, d):
    # bc: (2^b*n+d-1)/d with scale=0 (truncating division, all values > 0)
    return (2 ** b * n + d - 1) // d


def fadj(b, n, d):
    d = d // gcd(n, d)
    return (2 ** b * (d - 1)) // d


def fmuls(b, n, d):
    s = 0
    while True:
        if fmul(s, n, d) >= 2 ** (b - 1):
            return s
        s += 1


def timeconst(hz):
    out = []
    out.append("/* Automatically generated by kernel/time/timeconst.bc */\n")
    out.append("/* Time conversion constants for HZ == %d */\n" % hz)
    out.append("\n")
    out.append("#ifndef KERNEL_TIMECONST_H\n")
    out.append("#define KERNEL_TIMECONST_H\n\n")
    out.append("#include <linux/param.h>\n")
    out.append("#include <linux/types.h>\n\n")
    out.append("#if HZ != %d\n" % hz)
    out.append('#error "include/generated/timeconst.h has the wrong HZ value!"\n')
    out.append("#endif\n\n")
    if hz < 2:
        out.append("#error Totally bogus HZ value!\n")
        return "".join(out)

    def hx(v):
        # bc prints hex digits in upper case
        return "%X" % v

    s = fmuls(32, 1000, hz)
    out.append("#define HZ_TO_MSEC_MUL32\tU64_C(0x%s)\n" % hx(fmul(s, 1000, hz)))
    out.append("#define HZ_TO_MSEC_ADJ32\tU64_C(0x%s)\n" % hx(fadj(s, 1000, hz)))
    out.append("#define HZ_TO_MSEC_SHR32\t%d\n" % s)

    s = fmuls(32, hz, 1000)
    out.append("#define MSEC_TO_HZ_MUL32\tU64_C(0x%s)\n" % hx(fmul(s, hz, 1000)))
    out.append("#define MSEC_TO_HZ_ADJ32\tU64_C(0x%s)\n" % hx(fadj(s, hz, 1000)))
    out.append("#define MSEC_TO_HZ_SHR32\t%d\n" % s)

    cd = gcd(hz, 1000)
    out.append("#define HZ_TO_MSEC_NUM\t\t%d\n" % (1000 // cd))
    out.append("#define HZ_TO_MSEC_DEN\t\t%d\n" % (hz // cd))
    out.append("#define MSEC_TO_HZ_NUM\t\t%d\n" % (hz // cd))
    out.append("#define MSEC_TO_HZ_DEN\t\t%d\n" % (1000 // cd))
    out.append("\n")

    s = fmuls(32, 1000000, hz)
    out.append("#define HZ_TO_USEC_MUL32\tU64_C(0x%s)\n" % hx(fmul(s, 1000000, hz)))
    out.append("#define HZ_TO_USEC_ADJ32\tU64_C(0x%s)\n" % hx(fadj(s, 1000000, hz)))
    out.append("#define HZ_TO_USEC_SHR32\t%d\n" % s)

    s = fmuls(32, hz, 1000000)
    out.append("#define USEC_TO_HZ_MUL32\tU64_C(0x%s)\n" % hx(fmul(s, hz, 1000000)))
    out.append("#define USEC_TO_HZ_ADJ32\tU64_C(0x%s)\n" % hx(fadj(s, hz, 1000000)))
    out.append("#define USEC_TO_HZ_SHR32\t%d\n" % s)

    cd = gcd(hz, 1000000)
    out.append("#define HZ_TO_USEC_NUM\t\t%d\n" % (1000000 // cd))
    out.append("#define HZ_TO_USEC_DEN\t\t%d\n" % (hz // cd))
    out.append("#define USEC_TO_HZ_NUM\t\t%d\n" % (hz // cd))
    out.append("#define USEC_TO_HZ_DEN\t\t%d\n" % (1000000 // cd))

    cd = gcd(hz, 1000000000)
    out.append("#define HZ_TO_NSEC_NUM\t\t%d\n" % (1000000000 // cd))
    out.append("#define HZ_TO_NSEC_DEN\t\t%d\n" % (hz // cd))
    out.append("#define NSEC_TO_HZ_NUM\t\t%d\n" % (hz // cd))
    out.append("#define NSEC_TO_HZ_DEN\t\t%d\n" % (1000000000 // cd))
    out.append("\n")

    out.append("#endif /* KERNEL_TIMECONST_H */\n")
    return "".join(out)


def main():
    args = [a for a in sys.argv[1:] if a not in ("-q", "-l", "--quiet")]
    if len(args) != 1:
        sys.stderr.write("bc-shim: only the timeconst.bc program is supported\n")
        return 1
    if "timeconst" not in open(args[0]).read():
        sys.stderr.write("bc-shim: %s is not kernel/time/timeconst.bc\n" % args[0])
        return 1
    hz = int(sys.stdin.read().strip().split()[0])
    sys.stdout.write(timeconst(hz))
    return 0


if __name__ == "__main__":
    sys.exit(main())
